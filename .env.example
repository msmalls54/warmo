# copy to .env and fill in
ANTHROPIC_API_KEY=sk-ant-...
# Optional OpenRouter provider. Keep the actual key out of this shared folder.
# Prepared Windows launchers read the private hw-test/warmo-desktop-runtime/openrouter.env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5

# 1 = fake tank (no hardware). 0 = real XIAO.
SIM=1
# printed on the XIAO's Serial Monitor at boot ("WARMO IP: http://...")
XIAO_URL=http://172.20.10.5

# patrol: roam, look, narrate, and save sightings
MODE=patrol
# llm (Claude decides) | rules (no API key needed)
POLICY=llm
MODEL=claude-haiku-5-5
MAX_STEPS=200
STEP_PAUSE_S=0.3
MISSION_ID=warmo-1

# ---- calibrate on the venue floor (see README) ----
PIVOT_MS_PER_DEG=6.5
ADVANCE_MS_PER_CM=25
# camera image sideways? 90 / 180 / 270
CAM_ROTATE=270
HFOV_DEG=60
DIST_K=3500

MCP_USE_ANONYMIZED_TELEMETRY=false
